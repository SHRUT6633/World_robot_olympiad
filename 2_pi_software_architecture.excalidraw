{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "id": "title",
      "type": "text", "x": 100, "y": -60, "width": 1400, "height": 50,
      "text": "FILE 2: PI SOFTWARE ARCHITECTURE — All Python Modules, Classes, Methods, Imports",
      "fontSize": 24, "fontFamily": 1, "textAlign": "center",
      "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "opacity": 100
    },

    { "id": "s1h", "type": "text", "x": 30, "y": 20, "width": 700, "height": 35, "text": "1. SYSTEM INFRASTRUCTURE  [pi/system/]", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b1a", "type": "rectangle", "x": 30, "y": 70, "width": 460, "height": 210, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t1a", "type": "text", "x": 45, "y": 85, "width": 430, "height": 180, "text": "manager.py — SystemManager\n  • __init__():  ConfigManager + TaskScheduler + HealthMonitor + PerfMonitor\n  • register(name, component): stores in self._components dict\n  • get(name):  retrieve component\n  • init_all():  calls comp.init() for each (async-aware)\n  • run():  scheduler.run() with SIGINT/SIGTERM handlers\n  • stop():  stop scheduler + perf monitor\n  • shutdown():  reversed-order comp.close() + health/perf logging\n\nscheduler.py — TaskScheduler\n  • Task class: name, callback, hz, priority, period, jitter, total_runs\n  • add(name, callback, hz, priority):  creates Task\n  • spin_once():  sort by priority DESC → if due → await callback\n  • run():  while _running: spin_once() + await sleep(0)\n  • stop() / stats()", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b1b", "type": "rectangle", "x": 520, "y": 70, "width": 460, "height": 210, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t1b", "type": "text", "x": 535, "y": 85, "width": 430, "height": 180, "text": "config_manager.py — ConfigManager (Singleton)\n  • _instance = None, _config = {}\n  • load(path=\"config/pi_config.yaml\"):  yaml.safe_load(file)\n  • get(*keys, default=None):  nested dict traversal\n  • set(*keys, value):  nested dict set\n  • @property all:  returns full config dict\n  Uses: PyYAML\n\nlogger.py — Logger (Singleton)\n  • init(name, level, log_dir):  RotatingFileHandler (5MB×3) + StreamHandler\n  • debug/info/warn/error/critical(msg)\n  • Format: \"time | LEVEL | name | message\"\n  • log = Logger()  — module-level singleton\n\nhealth_monitor.py — HealthMonitor(timeout=2.0s)\n  • heartbeat(component):  records timestamp\n  • check(component):  True if within timeout\n  • check_all():  {name: bool}  |  status dict  |  summary()", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b1c", "type": "rectangle", "x": 1010, "y": 70, "width": 460, "height": 210, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t1c", "type": "text", "x": 1025, "y": 85, "width": 430, "height": 180, "text": "performance_monitor.py — PerformanceMonitor(interval=1s)\n  • start():  daemon thread _monitor()\n  • stop():  sets _running=False\n  • _monitor():  psutil.cpu_percent() + virtual_memory() stored (600 samples)\n  • @property cpu_avg / ram_avg:  mean of last 10\n  • report():  {cpu_avg, ram_avg}\n  Uses: psutil\n\nmemory_manager.py — MemoryManager(warning=200MB, critical=100MB)\n  • collect():  gc.collect() with before/after log\n  • auto_collect():  if memory < threshold → gc\n  Uses: gc, psutil\n\ndiagnostics.py — Diagnostics(manager=None)\n  • snapshot():  {timestamp, tasks, health, perf}\n  • dump():  JSON of last 100 snapshots", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s2h", "type": "text", "x": 30, "y": 320, "width": 700, "height": 35, "text": "2. HARDWARE ABSTRACTION  [pi/hardware/]", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b2", "type": "rectangle", "x": 30, "y": 370, "width": 700, "height": 130, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t2", "type": "text", "x": 45, "y": 385, "width": 670, "height": 100, "text": "led.py — StatusLED(green=GPIO23, red=GPIO24, blue=None)\n  • Uses gpiozero.LED if available, else mock logging\n  • set(color):  writes (g,r,b) — patterns: off, green, red, amber, blue\n  • blink(color, interval=0.5):  thread toggles on/off\n  • blink_pattern([colors], interval):  cycle sequence\n  • success_sequence():  3× green blink → steady green\n  • error_sequence():  red blink @ 0.3s\n  • stop_blink() / close()\n\nswitch.py — StartSwitch(pin=GPIO25, pull_up=True)\n  • Uses gpiozero.Button (when_pressed callback sets threading.Event)\n  • Mock mode:  auto-press in 2s\n  • wait_for_press(timeout=None):  blocks until pressed\n  • was_pressed() / reset() / close()", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s3h", "type": "text", "x": 30, "y": 540, "width": 700, "height": 35, "text": "3. SENSOR DRIVERS  [pi/sensors/]", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b3a", "type": "rectangle", "x": 30, "y": 590, "width": 460, "height": 180, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t3a", "type": "text", "x": 45, "y": 605, "width": 430, "height": 150, "text": "base.py — SensorBase (ABC) + FilteredSensorMixin\n  • SensorBase:  init() / read_raw() / read() / close() / enabled property\n  • FilteredSensorMixin(window=5):  filter_median() / filter_moving_avg() / filter_outliers(thresh=3)\n  Uses: numpy\n\ncamera/camera_driver.py — PiCamera(SensorBase)\n  • __init__(device=0, 640×480, 60fps)\n  • init():  cv2.VideoCapture(device, CAP_V4L2) + set props\n  • read_raw():  ret, frame = cap.read()  |  @property frame\n  • close():  cap.release()\n  Uses: opencv-python\n\ncamera/calibration.py — CameraCalibration (matrix, dist coeffs)\ncamera/pipeline.py — CameraPipeline (preprocessing pipeline)", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b3b", "type": "rectangle", "x": 520, "y": 590, "width": 460, "height": 180, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t3b", "type": "text", "x": 535, "y": 605, "width": 430, "height": 150, "text": "imu/mpu6050.py — MPU6050(SensorBase)\n  • __init__(bus=1, addr=0x68, accel=±4g, gyro=±500°/s)\n  • init():  smbus2.SMBus — writes 0x6B, 0x1C, 0x1B, 0x1A\n  • read_raw():  ax,ay,az (reg 0x3B-0x3F) + gx,gy,gz (0x43-0x47) → scaled\n  • calibrate_gyro_bias(samples=200) / calibrate_accel_bias(samples=100)\n  • close()\n  Mock:  returns random -100..100\n  Uses: smbus2, numpy\n\nimu/filtering.py — LPF, moving average filters\nimu/allan_variance.py — Allan variance noise analysis\nimu/temp_compensation.py — Temperature compensation", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b3c", "type": "rectangle", "x": 1010, "y": 590, "width": 460, "height": 180, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t3c", "type": "text", "x": 1025, "y": 605, "width": 430, "height": 150, "text": "tof/vl53l0x.py — VL53L0X(SensorBase, FilteredSensorMixin)\n  • __init__(name, bus=1, addr=0x30)\n  • read_raw():  read_i2c_block_data(0x00, 12) → range_mm\n  • read():  raw → filter_outliers → filter_moving_avg\n  Uses: smbus2\n\ntof/vl53l1x.py — VL53L1X(SensorBase, FilteredSensorMixin)\n  • __init__(name, bus=1, addr=0x32)\n  • read_raw():  read block 17 bytes + status check\n  • read():  filtered\n  Uses: smbus2\n\ntof/calibration.py — ToF calibration\ntof/cross_verify.py — Cross-verification between ToFs\n\nmagnetometer/qmc5883l.py — QMC5883L(SensorBase)\n  • __init__(bus=1, addr=0x0D)\n  • read_raw():  6 bytes → x,y,z (16-bit)\n  • read():  soft_iron @ (raw - hard_iron)\n  • calibrate_hard_iron(samples=500):  (max+min)/2\n  • heading(mag, accel):  tilt-compensated heading in degrees\n  Uses: smbus2, numpy\n\nmagnetometer/tilt_compensation.py / disturbance.py", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s4h", "type": "text", "x": 30, "y": 810, "width": 700, "height": 35, "text": "4. SENSOR FUSION  [pi/fusion/]", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b4a", "type": "rectangle", "x": 30, "y": 860, "width": 700, "height": 170, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t4a", "type": "text", "x": 45, "y": 875, "width": 670, "height": 140, "text": "ukf.py — RobotUKF(dt=0.01)  [PRIMARY FILTER]\n  • dim_x=6, dim_z=6  — state: [x, y, heading, v, a, yaw_rate]\n  • Uses: filterpy — UnscentedKalmanFilter + MerkedScaledSigmaPoints(α=0.1, β=2, κ=0)\n  • _fx(state, dt):  bicycle kinematics motion model\n  • _hx(state):  identity measurement function\n  • predict(dt):  ukf.predict()  |  update(z):  ukf.update(z)\n  • @property state → x  |  @property covariance → P\n  • set_process_noise(Q) / set_measurement_noise(R) / set_state(x, P)\n\nekf.py — RobotEKF(ExtendedKalmanFilter)  [ALTERNATIVE]\n  • Same state vector, uses filterpy ExtendedKalmanFilter\n  • predict():  Jacobian F matrix, state propagation\n  • update(z):  Kalman gain, state update\n\ncomplementary.py — ComplementaryFilter(α=0.98, dt=0.01)\n  • pitch/roll/yaw state\n  • update(accel, gyro, mag_heading):  fuses gyro integration with accel/mag\n  • Returns (pitch, roll, yaw)\n\nadaptive_noise.py — AdaptiveNoiseEstimator(window=100)\n  • update(innovation, residual):  store in deque\n  • estimate_q(dim):  covariance of innovations  |  estimate_r(dim):  covariance of residuals\n\nmahalanobis.py — MahalanobisOutlierRejector(threshold=3.0)\n  • test(z, mean, cov):  Mahalanobis distance check\n  • reject_outliers(z, predicted, S):  boolean mask", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s5h", "type": "text", "x": 30, "y": 1070, "width": 700, "height": 35, "text": "5. LOCALIZATION + PERCEPTION", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b5a", "type": "rectangle", "x": 30, "y": 1120, "width": 460, "height": 170, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t5a", "type": "text", "x": 45, "y": 1135, "width": 430, "height": 140, "text": "LOCALIZATION [pi/localization/]\n\nrobot_localization.py — RobotLocalization\n  • pose = PoseEstimator()\n  • attach_filter(estimator):  UKF or EKF\n  • predict(dt) / update(measurements)\n  • to_dict():  calls pose.to_dict()\n\npose_estimation.py — PoseEstimator\n  • x, y, heading, velocity, yaw_rate\n  • update_odometry(v, yaw_rate, dt):  bicycle model\n  • update_absolute(x, y, heading):  from filter\n  • to_dict():  {x, y, heading, v, yaw_rate}\n\nAlso:  pose_graph.py, occupancy_grid.py,\nloop_closure.py, feature_map.py", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b5b", "type": "rectangle", "x": 520, "y": 1120, "width": 460, "height": 170, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t5b", "type": "text", "x": 535, "y": 1135, "width": 430, "height": 140, "text": "PERCEPTION [pi/perception/]\n\nlane_detection.py — LaneDetector(roi=0.4)\n  • detect(img):  gray → GaussianBlur → Canny(50,150)\n    → HoughLinesP(1, π/180, 30, 20, 50)\n    → returns [{x1,y1,x2,y2}] line array\n  Uses: opencv-python\n\nfree_space.py — FreeSpaceDetector(sobel_thresh=(30,150))\n  • detect(img):  gray → SobelX + SobelY → magnitude\n    → threshold(BINARY_INV) → free space mask\n  Uses: opencv-python\n\nwall_detection.py — WallDetector(threshold=500mm)\n  • detect(left, right, front dist):  {left, right, front} bool\n\nAlso:  road_edge.py, visual_odometry.py, optical_flow.py,\nobject_detection.py, landmark_detection.py,\nfeature_matching.py, depth_estimation.py, corner_detection.py", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s6h", "type": "text", "x": 30, "y": 1330, "width": 700, "height": 35, "text": "6. PLANNING + TRAJECTORY + CONTROL", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b6a", "type": "rectangle", "x": 30, "y": 1380, "width": 460, "height": 200, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t6a", "type": "text", "x": 45, "y": 1395, "width": 430, "height": 170, "text": "PLANNING [pi/planning/]\n\nglobal_planner.py — GlobalPlanner\n  • waypoints = []\n  • plan_rectangle(w, h):  [(0,0), (w,0), (w,h), (0,h), (0,0)]\n  • plan_lap(track_w=3.0, track_h=5.0):  calls plan_rectangle\n  • get_target(index):  returns waypoint or None\n\nAlso:  hybrid_astar.py, dynamic_avoidance.py,\nwaypoint_generator.py, waypoint_optimizer.py,\nsafe_corridor.py\n\nTRAJECTORY [pi/trajectory/]\n\ncubic_splines.py — CubicSplineTrajectory(num=50)\n  • fit(waypoints):  scipy CubicSpline bc_type=\"natural\"\n    → dense (50,2) array\n  Uses: scipy.interpolate\n\nAlso:  bezier.py, velocity_profile.py,\nacceleration_limits.py, jerk_minimization.py,\nsmoothing.py, curvature_opt.py", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b6b", "type": "rectangle", "x": 520, "y": 1380, "width": 460, "height": 200, "strokeColor": "#e03131", "backgroundColor": "#fff5f5", "fillStyle": "solid", "strokeWidth": 3, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t6b", "type": "text", "x": 535, "y": 1395, "width": 430, "height": 170, "text": "★ CONTROL [pi/control/] — GENERATES UART COMMANDS\n\nstanley.py — StanleyController(k=0.5, k_soft=1.0, max=30°)\n  • compute(x, y, heading, tx, ty, thead, v):\n    crosstrack = -sin(h)×dx + cos(h)×dy\n    heading_err = normalize(thead - heading)\n    steer = heading_err + atan2(k×crosstrack, k_soft+v)\n    return clip(steer, -max, +max)\n\nadaptive_pid.py — AdaptivePID(kp=0.5, ki=0.05, kd=0.01, dt=0.01)\n  • compute(error, limit):  PID output with integral/derivative\n  • reset():  clear integral + last_error\n\nservo_pid.py — ServoPID(AdaptivePID) kp=0.8, ki=0.05, kd=0.02\n  • compute_angle(target, current):  clamp(-30°, +30°)\n\nmotor_pid.py — MotorPID(AdaptivePID) kp=0.5, ki=0.1, kd=0.01\n  • compute_speed(target, current):  clamp(0, 255)\n\nAlso:  mpc.py, feedforward.py, feedforward_comp.py,\nfeedback.py, gain_scheduling.py, anti_windup.py", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s7h", "type": "text", "x": 30, "y": 1620, "width": 700, "height": 35, "text": "7. DYNAMICS + COMMUNICATION + MISSION", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b7a", "type": "rectangle", "x": 30, "y": 1670, "width": 460, "height": 170, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t7a", "type": "text", "x": 45, "y": 1685, "width": 430, "height": 140, "text": "DYNAMICS [pi/dynamics/]\n\nkinematic_model.py — KinematicModel(wheelbase=0.26m)\n  • update(x, y, heading, v, delta, dt):\n    bicycle model: x += v·cos(θ)·dt  |  y += v·sin(θ)·dt\n    heading += (v/L)·tan(δ)·dt\n  • compute_steering(v, yaw_rate):  atan(L·ω/v)\n\nAlso:  dynamic_bicycle.py, ackermann.py,\nturning_radius.py, yaw_dynamics.py, tire_slip.py,\nmechanical_linkage.py, future_prediction.py\n\nMISSION [pi/mission/]\n\nstate_machine.py — StateMachine + RobotState(Enum)\n  11 states: INIT, IDLE, START_SEARCH, FORWARD, CORNERING,\n  OBSTACLE_AVOID, REVERSE, LAP_FINISHED, PARK, EMERGENCY_STOP, SHUTDOWN\n  add_transition(from, to, condition) | set_entry/exit(state, action)\n\nlap_counter.py — LapCounter(2 laps)\nrace_strategy.py — exploration/racing/cautious modes\nstart_detection.py — template match\nobstacle_strategy.py | reverse_logic.py | checkpoint.py", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b7b", "type": "rectangle", "x": 520, "y": 1670, "width": 700, "height": 170, "strokeColor": "#e03131", "backgroundColor": "#fff5f5", "fillStyle": "solid", "strokeWidth": 3, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t7b", "type": "text", "x": 535, "y": 1685, "width": 670, "height": 140, "text": "★ COMMUNICATION [pi/comm/] — UART PROTOCOL\n\nprotocol.py — Packet + PacketType(IntEnum)\n\nPacket Types:  MOTOR_CMD=0x01 | SERVO_CMD=0x02 | STEERING_CMD=0x03\n  STATUS_REQ=0x04 | STATUS_RESP=0x05 | EMERGENCY_STOP=0xFF\n\nPacket.encode():  [0xA5][counter][type][len][payload][CRC16][0x5A]\n  CRC-16-CCITT: poly=0x8005, init=0xFFFF\n\nPacket.decode(data):  validates header/footer/CRC\n\nStatic methods:\n  make_steering_command(counter, servo_angle, motor_speed):\n    payload = struct.pack(\"<fB\", angle, speed)\n  make_emergency_stop(counter)\n\nuart.py — UARTCommunicator(port=\"/dev/serial0\", baud=115200, timeout=50ms)\n  init():  serial.Serial(port, baud)\n  send(pkt):  pkt.encode() → serial.write()\n  send_steering(angle, speed):  make + send STEERING_CMD\n  send_emergency_stop():  make + send EMERGENCY_STOP\n  read():  if in_waiting≥8 → decode → store in deque\n  @property is_connected:  heartbeat < 1.0s ago\n  close()\n\nUART Frame Structure:\n┌─────┬──────┬──────┬──────┬─────────┬──────┬──────┐\n│ 0xA5│ count│ type │ len  │ payload │CRC16 │ 0x5A │\n│  1B  │  1B  │  1B  │  1B  │  0-24B  │  2B  │  1B  │\n└─────┴──────┴──────┴──────┴─────────┴──────┴──────┘", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s8h", "type": "text", "x": 30, "y": 1880, "width": 700, "height": 35, "text": "8. SELF-TEST SUITE  [pi/selftest/]", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b8a", "type": "rectangle", "x": 30, "y": 1930, "width": 700, "height": 160, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t8a", "type": "text", "x": 45, "y": 1945, "width": 670, "height": 130, "text": "runner.py — SelfTestRunner + TestResult\n  • TestResult:  PASS/FAIL/SKIP, duration_ms, message, data\n  • add(name, func):  register test function\n  • run_all():  execute each → log [OK]/[!!]/[-] → return {total, passed, failed, skipped}\n\nTest Files:\n  tests_camera.py  — camera_init, camera_capture\n  tests_tof.py     — per-sensor 5-sample avg, range check\n  tests_imu.py     — imu_init, imu_readings\n  tests_mag.py     — mag_init, mag_heading\n  tests_fusion.py  — ukf_predict, ukf_update, complementary\n  tests_control.py — stanley, servo_pid, motor_pid, kinematics\n  tests_comm.py    — packet_encode, packet_decode, crc_detection, uart_connect, esp_echo, heartbeat\n  → TOTAL: ~20+ test functions\n\nAlso in pi/:  sync/ (frame_sync, timestamp, latency, buffer_manager)", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s9h", "type": "text", "x": 30, "y": 2140, "width": 700, "height": 35, "text": "9. EXTERNAL PACKAGES  [requirements.txt]", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#7950f2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b9a", "type": "rectangle", "x": 30, "y": 2190, "width": 1200, "height": 150, "strokeColor": "#7950f2", "backgroundColor": "#f3f0ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 12 } },
    { "id": "t9a", "type": "text", "x": 45, "y": 2205, "width": 1170, "height": 120, "text": "numpy≥1.24.0      — Arrays, linear algebra, stats  →  fusion, control, dynamics, perception\nscipy≥1.10.0      — CubicSpline interpolation     →  trajectory/cubic_splines.py\nopencv-python≥4.8 — cv2 camera, Canny, Hough, Sobel →  camera_driver, lane_detection, free_space\nopencv-contrib    — Additional OpenCV modules\nPyYAML≥6.0        — YAML config parsing            →  config_manager.py\npyserial≥3.5      — UART serial communication       →  comm/uart.py\nsmbus2≥0.4.2      — I²C bus communication           →  imu, tof, magnetometer drivers\nfilterpy≥1.4.5    — Unscented/Extended Kalman Filter →  fusion/ukf.py, fusion/ekf.py\nnumba≥0.57.0      — JIT compilation for perf\npsutil≥5.9.0      — CPU/RAM monitoring              →  performance_monitor.py, memory_manager.py\ncoloredlogs≥15.0  — Colored terminal log output\npytest≥7.4.0      — Unit test framework             →  tests/\n\nESP-IDF:  ESP32 IoT Development Framework  —  FreeRTOS, LEDC, UART, GPIO drivers\nCMake 3.5+:  Build system for ESP32-S3  —  project(wro_4ws_esp32)", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "strokeColor": "#7950f2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 }
  ],
  "files": {}
}