  "elements": [
    {
      "id": "title",
      "type": "text", "x": 100, "y": -60, "width": 1400, "height": 50,
      "text": "FILE 3: ESP32-S3 FIRMWARE — C Modules, FreeRTOS, GPIO, Packet Processing, Drivers",
      "fontSize": 24, "fontFamily": 1, "textAlign": "center",
      "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "opacity": 100
    },

    { "id": "s1h", "type": "text", "x": 30, "y": 20, "width": 900, "height": 35, "text": "1. COMPLETE FILE LIST — esp/main/ (21 files: 11 .c + 10 .h + CMake + Kconfig)", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "bf1", "type": "rectangle", "x": 30, "y": 70, "width": 1200, "height": 200, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "tf1", "type": "text", "x": 45, "y": 85, "width": 1170, "height": 170, "text": "Project:  esp/CMakeLists.txt  —  cmake_minimum(VERSION 3.5) + project(wro_4ws_esp32) + include(IDF_PATH)\n\nFILE                    |  LINES  |  PURPOSE\n────────────────────────┼────────┼──────────────────────────────────────────────────────────────────\nmain.c                  │   326  │  ENTRY: app_main() — hardware init, 5 FreeRTOS tasks, packet processing\ncrc.c      / crc.h      │    18  │  CRC-16-CCITT: poly=0x8005, init=0xFFFF, bitwise algorithm\nuart_receiver.c /.h     │    15  │  UART byte-level receive wrapper\npacket_validator.c /.h  │    14  │  Header(0xA5)/Footer(0x5A)/CRC-16 validation\ncommand_validator.c /.h │    31  │  Command type/length/range semantic validation\ntimeout_detector.c /.h  │    19  │  500ms comm timeout detection\nwatchdog.c    / .h      │    19  │  Hardware WDT: 3s timeout → panic reset\nfailsafe.c   / .h       │    16  │  Emergency stop: motors off, servo center\nservo_pwm.c  / .h       │    54  │  Servo: GPIO13, LEDC TIM0, 50Hz, 12-bit, 500-2500μs\nmotor_pwm.c  / .h       │    42  │  Motor: GPIO11, LEDC TIM1, 20kHz, 10-bit, 0-1023 duty\nl298n.c        / .h       │    27  │  L298N driver: ENA=GPIO11, IN1=GPIO8, IN2=GPIO9, direction logic\nselftest.c   / .h       │    97  │  ESP32 self-test: 5 sub-tests (UART, servo, motor, L298N, WDT)\nKconfig.projbuild       │   n/a  │  ESP-IDF menuconfig options\n────────────────────────┴────────┴──────────────────────────────────────────────────────────────────\nTotal: ~700 lines of C code, flashed via:  idf.py -C esp flash  (or scripts/flash_esp.sh)", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s2h", "type": "text", "x": 30, "y": 310, "width": 900, "height": 35, "text": "2. app_main() — 12-STEP BOOT SEQUENCE", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b2a", "type": "rectangle", "x": 30, "y": 360, "width": 380, "height": 75, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t2a", "type": "text", "x": 45, "y": 375, "width": 350, "height": 45, "text": "Step 1: memset state, ESP_STATE_BOOT\n        led_both_on() → Amber", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b2b", "type": "rectangle", "x": 450, "y": 360, "width": 380, "height": 75, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t2b", "type": "text", "x": 465, "y": 375, "width": 350, "height": 45, "text": "Step 2: led_init()  GPIO2=Green, GPIO4=Red\n        gpio_config OUTPUT, both LOW", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b2c", "type": "rectangle", "x": 870, "y": 360, "width": 380, "height": 75, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t2c", "type": "text", "x": 885, "y": 375, "width": 350, "height": 45, "text": "Step 3: uart_init()  UART_NUM_1\n        GPIO17=TX, GPIO18=RX, 115200 8N1", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b2d", "type": "rectangle", "x": 30, "y": 465, "width": 380, "height": 75, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t2d", "type": "text", "x": 45, "y": 480, "width": 350, "height": 45, "text": "Step 4: l298n_init()  ENA=GPIO11, IN1=GPIO8, IN2=GPIO9", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b2e", "type": "rectangle", "x": 450, "y": 465, "width": 380, "height": 75, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t2e", "type": "text", "x": 465, "y": 480, "width": 350, "height": 45, "text": "Step 5: servo_pwm_init()  GPIO13\n        LEDC TIMER0: 50Hz, 12-bit\nStep 6: motor_pwm_init()  GPIO11\n        LEDC TIMER1: 20kHz, 10-bit", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b2f", "type": "rectangle", "x": 870, "y": 465, "width": 380, "height": 75, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t2f", "type": "text", "x": 885, "y": 480, "width": 350, "height": 45, "text": "Step 7: watchdog_init()  esp_task_wdt\n        3000ms timeout, trigger_panic=true\nStep 8: failsafe_init()", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b2g", "type": "rectangle", "x": 30, "y": 570, "width": 600, "height": 80, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t2g", "type": "text", "x": 45, "y": 585, "width": 570, "height": 50, "text": "Step 9: ESP SELF-TEST  esp_selftest_init() → esp_selftest_run(&result)\n        5 tests: UART, Servo PWM, Motor PWM, TB6612FNG, Watchdog\nStep 10: ALL PASSED → state=READY, Green LED ON  |  FAIL → state=ERROR, Red LED ON", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b2h", "type": "rectangle", "x": 30, "y": 680, "width": 600, "height": 65, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t2h", "type": "text", "x": 45, "y": 695, "width": 570, "height": 35, "text": "Step 11: xTaskCreate() × 5 — uart_rx(pri=10) > watchdog(9) > timeout(8) > led(6) > status(5)\nStep 12: while(1) { vTaskDelay(1000ms); }  — main idle, tasks run concurrently", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "arr-a1", "type": "arrow", "x": 410, "y": 397, "width": 40, "height": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "points": [[0,0],[40,0]] },
    { "id": "arr-a2", "type": "arrow", "x": 830, "y": 397, "width": 40, "height": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "points": [[0,0],[40,0]] },
    { "id": "arr-a3", "type": "arrow", "x": 870, "y": 435, "width": 0, "height": 30, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "points": [[0,0],[0,30]] },
    { "id": "arr-a4", "type": "arrow", "x": 220, "y": 540, "width": 0, "height": 30, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "points": [[0,0],[0,30]] },
    { "id": "arr-a5", "type": "arrow", "x": 330, "y": 650, "width": 0, "height": 30, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "points": [[0,0],[0,30]] },

    { "id": "s3h", "type": "text", "x": 30, "y": 790, "width": 900, "height": 35, "text": "3. PACKET PROCESSING PIPELINE (UART RX → Validation → Actuation)", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b3a", "type": "rectangle", "x": 30, "y": 840, "width": 1250, "height": 320, "strokeColor": "#e03131", "backgroundColor": "#fff5f5", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t3a", "type": "text", "x": 45, "y": 855, "width": 1220, "height": 290, "text": "STEP 1: uart_read_bytes(UART_NUM_1, rx_buf, 256, 10ms timeout)\n        → reads raw bytes from UART1 FIFO buffer\n\nSTEP 2: BYTE STATE MACHINE [main.c uart_rx_task lines 197-239]\n        if byte == 0xA5 (HEADER):  start new packet, reset index\n        if byte == 0x5A (FOOTER) && packet_idx >= 8:  complete packet detected\n        if buffer overflow (≥32):  reset\n\nSTEP 3: CRC-16 VERIFICATION [packet_validator.c + crc.c]\n        calc_crc = crc16(packet_buf, len-3)\n        if calc_crc == pkt->crc:  VALID → process\n        else:  g_state.crc_errors++, ESP_LOGW, discard\n\nSTEP 4: process_packet(pkt) [main.c lines 159-195] — Dispatches by msg_type:\n\n┌─ PKT_STEERING_CMD (0x03) — len must ≥ 5:\n│    memcpy(&angle, payload, 4)  → float  (-30° to +30°)\n│    speed = payload[4]          → uint8 (0-100%)\n│    servo_set_angle(angle)      → LEDC duty calc → GPIO13\n│    motor_set_speed(speed)      → duty = speed×1023/100 → GPIO11\n│    state = ESP_STATE_ACTIVE\n│\n├─ PKT_EMERGENCY_STOP (0xFF):\n│    motor_set_speed(0), servo_set_angle(0), state=FAILSAFE, Red LED\n│    Blocks ALL further motor commands\n│\n├─ PKT_STATUS_REQ (0x04): send 6-byte response: [uart_ok][state][uptime_ms(2B)][packets][errors]\n│\n└─ PKT_SELFTEST_REQ (0x06): send 8-byte response: all 5 test results + duration + all_passed\n\nUART CONFIG:  Port=UART_NUM_1  TX=GPIO17  RX=GPIO18  Baud=115200  8N1  No flow control\n\nPACKET STRUCTURE (typedef struct __attribute__((packed))):\n  [uint8_t header=0xA5][uint8_t counter][uint8_t msg_type][uint8_t length]\n  [uint8_t payload[24]][uint16_t crc][uint8_t footer=0x5A]\n\nPAYLOAD FORMATS:\n  STEERING_CMD: [float servo_angle (4B)] [uint8_t motor_speed (1B)]  = 5 bytes payload\n  STATUS_RESP:  [uart_ok][state][uptime_lo][uptime_hi][packets][crc_errors]        = 6 bytes\n  SELFTEST_RESP: [uart][servo][motor][tb6612][wdt][duration_lo][duration_hi][all]  = 8 bytes", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s4h", "type": "text", "x": 30, "y": 1210, "width": 900, "height": 35, "text": "4. FIVE FreeRTOS TASKS — Full Implementation Details", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b4a", "type": "rectangle", "x": 30, "y": 1260, "width": 620, "height": 250, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t4a", "type": "text", "x": 45, "y": 1275, "width": 590, "height": 220, "text": "TASK 1: uart_rx_task  [stack=4096, priority=10 — HIGHEST]\n  void uart_rx_task(void *arg) {\n      rx_buf = malloc(UART_BUF_SIZE);  packet_buf[32];\n      while (1) {\n          len = uart_read_bytes(UART1, rx_buf, 256, 10ms);\n          for each byte:  // byte state machine\n              if byte==0xA5: start packet\n              if in_packet: append to packet_buf\n              if byte==0x5A && idx>=8:\n                  calc_crc = crc16(buf, len-3)\n                  if calc_crc == pkt->crc:\n                      process_packet(pkt)\n                      g_state.packets_received++\n                  else:  g_state.crc_errors++\n          vTaskDelay(1ms);  // ~1kHz polling\n      }\n  }\n\nTASK 2: timeout_monitor_task  [stack=2048, priority=8]\n  void timeout_monitor_task(void *arg) {\n      while (1) {\n          now = esp_timer_get_time();\n          if (last_packet > 0 && (now-last_packet) > 500000 && motor_enabled) {\n              motor_set_speed(0);  servo_set_angle(0);\n              motor_enabled = false;  state = FAILSAFE;\n              led_red_on();\n              ESP_LOGW(\"Comm timeout! Stopping motors.\");\n          }\n          vTaskDelay(50ms);\n      }\n  }\n  SAFETY: 500ms comm timeout → auto emergency stop", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b4b", "type": "rectangle", "x": 680, "y": 1260, "width": 600, "height": 250, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t4b", "type": "text", "x": 695, "y": 1275, "width": 570, "height": 220, "text": "TASK 3: watchdog_task  [stack=2048, priority=9]\n  void watchdog_task(void *arg) {\n      while (1) {\n          watchdog_feed();  // esp_task_wdt_reset()\n          vTaskDelay(500ms);\n      }\n  }\n  Hardware WDT: 3000ms timeout\n  If not fed for 3s → ESP32 hardware reset!\n  Safety: prevents firmware hangs\n\nTASK 4: status_task  [stack=2048, priority=5 — LOWEST]\n  void status_task(void *arg) {\n      while (1) {\n          g_state.uptime_ms = esp_timer_get_time() / 1000;\n          vTaskDelay(100ms);\n      }\n  }\n  Used by send_status_response()\n\nTASK 5: led_indicator_task  [stack=2048, priority=6]\n  void led_indicator_task(void *arg) {\n      while (1) {\n          switch (g_state.state) {\n              case ESP_STATE_BOOT:      led_both_on();     // Amber\n              case ESP_STATE_SELFTEST:  led_blue();        // Blue\n              case ESP_STATE_READY:     led_green_on();    // Green\n              case ESP_STATE_ACTIVE:    led_green_on();    // Green\n              case ESP_STATE_ERROR:     led_red_on();      // Red\n              case ESP_STATE_FAILSAFE:  led_red_on();      // Red\n          }\n          vTaskDelay(100ms);\n      }\n  }", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s5h", "type": "text", "x": 30, "y": 1560, "width": 900, "height": 35, "text": "5. ESP32 STATE MACHINE + SELF-TEST DETAIL", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b5a", "type": "rectangle", "x": 30, "y": 1610, "width": 620, "height": 160, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t5a", "type": "text", "x": 45, "y": 1625, "width": 590, "height": 130, "text": "esp_state_t Transitions:\n  BOOT(0) → SELFTEST(1) → READY(2) ↔ ACTIVE(3) → FAILSAFE(5)\n                           SELFTEST(1) → ERROR(4)\n\n  READY:  Waiting for Pi steering command\n  ACTIVE: Receiving commands, motors running\n  FAILSAFE: Motors stopped, emergency_stop flag prevents actuation\n  ERROR: Self-test failed, hardware issue\n\nesp_selftest_result_t [selftest.c]:\n  bool uart_ok       — GPIO2 LED toggle (10ms)\n  bool servo_pwm_ok  — LEDC TIM0 set duty 1500μs\n  bool motor_pwm_ok  — LEDC TIM1 set 50% duty → 0\n  bool tb6612fng_ok  — STBY=1, AIN1=1, AIN2=0, 1ms, reset\n  bool watchdog_ok   — Always passes (can't test w/o reset)\n  uint32_t test_duration_ms\n\n  All passed → state=READY, Green LED, ESP_LOGI", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b5b", "type": "rectangle", "x": 680, "y": 1610, "width": 600, "height": 160, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t5b", "type": "text", "x": 695, "y": 1625, "width": 570, "height": 130, "text": "SERVO PWM DRIVER [servo_pwm.c] — GPIO13, LEDC TIM0, 50Hz, 12-bit\n  servo_set_angle(float angle_deg):\n    angle = clamp(-30°, +30°)\n    pulse_us = 1500 + (angle/30) × (2500-1500)\n    pulse_us = clamp(500, 2500)\n    duty = (4096 × pulse_us) / 20000\n    ledc_set_duty(LOW, CH0, duty) + ledc_update_duty\n\n  MG995 Servo: 4.8-7.2V, 2.5kg·cm @ 6V, 0.2s/60°\n  ▸ 500μs = -30° (full left)  ▸ 1500μs = 0° (center)  ▸ 2500μs = +30° (full right)\n\nMOTOR PWM DRIVER [motor_pwm.c] — GPIO11, LEDC TIM1, 20kHz, 10-bit\n  motor_set_speed(uint8_t speed_pct):\n    speed_pct = min(100)\n    duty = speed_pct × 1023 / 100\n    ledc_set_duty(LOW, CH1, duty) + ledc_update_duty\n\nTB6612FNG DRIVER [tb6612fng.c] — GPIOs: STBY=10, AIN1=8, AIN2=9, BIN1=6, BIN2=7\n  Truth Table:  AIN1=1,AIN2=0 → Forward  |  AIN1=0,AIN2=1 → Reverse\n                AIN1=1,AIN2=1 → Brake     |  AIN1=0,AIN2=0 → Coast", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s6h", "type": "text", "x": 30, "y": 1820, "width": 900, "height": 35, "text": "6. ESP32-S3 COMPLETE PINOUT", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b6a", "type": "rectangle", "x": 30, "y": 1870, "width": 1250, "height": 150, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "t6a", "type": "text", "x": 45, "y": 1885, "width": 1220, "height": 120, "text": "GPIO  |  Function          | Connected To\n──────┼────────────────────┼──────────────────────────────────────\n  2   |  Green Status LED  | Anode via 330Ω resistor → GND\n  4   |  Red Status LED    | Anode via 330Ω resistor → GND\n  6   |  TB6612FNG BIN1    | Motor B direction 1\n  7   |  TB6612FNG BIN2    | Motor B direction 2\n  8   |  TB6612FNG AIN1    | Motor A direction 1\n  9   |  TB6612FNG AIN2    | Motor A direction 2\n 10   |  TB6612FNG STBY    | Standby control (HIGH = enabled)\n 11   |  TB6612FNG PWMA    | Motor speed PWM (20kHz, 10-bit)\n 12   |  TB6612FNG PWMB    | Motor B speed PWM (optional)\n 13   |  MG995 Servo PWM   | Servo control signal (50Hz, 12-bit)\n 17   |  UART1 TX          | → Raspberry Pi /dev/serial0 RX\n 18   |  UART1 RX          | ← Raspberry Pi /dev/serial0 TX\n──────┴────────────────────┴──────────────────────────────────────\n\nPower: ESP32-S3 powered via 5V pin from Pi or regulator\n  MG995 Servo: requires separate 5-7.4V supply (high current draw 0.5-2A)\n  TB6612FNG: VM from battery (7.4-11.1V), logic VCC from 3.3V/5V\n  All I²C sensors: 3.3V from Pi or regulator (shared rail)", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 }
  ],
  "files": {}
}