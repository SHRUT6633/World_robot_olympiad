{
  "type": "excalidraw",
  "version": 2,
  "source": "https://excalidraw.com",
  "elements": [
    {
      "id": "title",
      "type": "text", "x": 100, "y": -60, "width": 1400, "height": 50,
      "text": "FILE 4: HARDWARE WIRING & COMMUNICATION — Physical Connections, Protocols, Power, Pinouts",
      "fontSize": 24, "fontFamily": 1, "textAlign": "center",
      "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "roughness": 0, "opacity": 100
    },

    { "id": "s1h", "type": "text", "x": 30, "y": 10, "width": 900, "height": 35, "text": "1. SYSTEM BLOCK DIAGRAM — All Physical Connections Between Components", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b1", "type": "rectangle", "x": 30, "y": 60, "width": 320, "height": 130, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 3, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 10 } },
    { "id": "t1", "type": "text", "x": 45, "y": 75, "width": 290, "height": 100, "text": "RASPBERRY PI 4B\nHIGH-LEVEL PROCESSING\nCPU: Cortex-A72 quad 1.5GHz\nRAM: 4GB LPDDR4\nPython 3.11 + OpenCV", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "b2", "type": "rectangle", "x": 460, "y": 60, "width": 320, "height": 130, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 3, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 10 } },
    { "id": "t2", "type": "text", "x": 475, "y": 75, "width": 290, "height": 100, "text": "ESP32-S3 WROOM-1\nLOW-LEVEL ACTUATION\nCPU: Xtensa LX7 dual 240MHz\nRAM: 512KB + 8MB PSRAM\nC/FreeRTOS/ESP-IDF", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "uart-arrow", "type": "arrow", "x": 350, "y": 125, "width": 110, "height": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 4, "roughness": 1, "opacity": 100, "points": [[0,0],[110,0]] },
    { "id": "uart-txt", "type": "text", "x": 355, "y": 95, "width": 100, "height": 30, "text": "UART @ 115200", "fontSize": 14, "fontFamily": 1, "textAlign": "center", "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },
    { "id": "uart-txt2", "type": "text", "x": 355, "y": 155, "width": 100, "height": 20, "text": "Pi TX(14)→ESP RX(18)", "fontSize": 12, "fontFamily": 1, "textAlign": "center", "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 80 },
    { "id": "uart-txt3", "type": "text", "x": 355, "y": 172, "width": 100, "height": 20, "text": "Pi RX(15)←ESP TX(17)", "fontSize": 12, "fontFamily": 1, "textAlign": "center", "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 80 },

    { "id": "i2c-label", "type": "text", "x": 30, "y": 220, "width": 700, "height": 25, "text": "RPi I²C BUS 1 — GPIO2(SDA) / GPIO3(SCL) — 3.3V — All sensors on shared bus:", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "sensor-row", "type": "rectangle", "x": 30, "y": 260, "width": 1250, "height": 100, "strokeColor": "#2f9e44", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "sensor-row-txt", "type": "text", "x": 45, "y": 275, "width": 1220, "height": 70, "text": "📡 VL53L0X \"Left\"    @ 0x30  |  📡 VL53L0X \"Right\"   @ 0x31  |  📡 VL53L1X \"Front\"   @ 0x32\n   Range: 50-1200mm            |  Range: 50-1200mm            |  Range: 100-4000mm\n   Side distance (left)        |  Side distance (right)       |  Front distance\n\n   🌀 MPU6050 IMU @ 0x68       |  🧭 QMC5883L Mag @ 0x0D\n   Accel: ±4g / Gyro: ±500°/s  |  ±1200μT, 100Hz output rate\n   6-DOF motion tracking       |  Tilt-compensated heading", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "camera-label", "type": "text", "x": 30, "y": 380, "width": 700, "height": 25, "text": "PiCamera Module → CSI-2 ribbon cable (15-pin, 2-lane MIPI) — 640×480 @ 60fps", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s2h", "type": "text", "x": 30, "y": 440, "width": 900, "height": 35, "text": "2. ACTUATOR CONNECTIONS (via ESP32-S3 GPIO)", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "act-box", "type": "rectangle", "x": 30, "y": 490, "width": 1250, "height": 200, "strokeColor": "#e67700", "backgroundColor": "#fff3e0", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "act-txt", "type": "text", "x": 45, "y": 505, "width": 1220, "height": 170, "text": "MG995 HIGH-TORQUE SERVO (Steering):\n  ESP32 GPIO13 (PWM) ───► Orange wire (signal)\n  5-7.4V external supply ──► Red wire (VCC)\n  GND ──────────────────────► Brown wire (GND)\n  PWM: 50Hz, 500-2500μs pulse, 12-bit resolution\n  Range: -30° to +30° (60° total, center=straight)\n  ▸ 500μs = -30° (max left)  ▸ 1500μs = 0° (center)  ▸ 2500μs = +30° (max right)\n\nL298N MOTOR DRIVER + DC Motor (single channel):\n  ESP32 GPIO11 ──► ENA (PWM speed, 20kHz 10-bit) @ `esp/main/l298n.c`\n  ESP32 GPIO8  ──► IN1 (direction)                  @ `esp/main/l298n.c`\n  ESP32 GPIO9  ──► IN2 (direction)                  @ `esp/main/l298n.c`\n\n  Motor Control Truth Table:\n    Forward: IN1=1, IN2=0, ENA=PWM\n    Reverse: IN1=0, IN2=1, ENA=PWM\n    Brake:   IN1=1, IN2=1\n    Coast:   IN1=0, IN2=0\n\n  Power: VM from battery (7.4-11.1V), VSS from logic supply\n  Output: 2A continuous per channel to DC motor", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s3h", "type": "text", "x": 30, "y": 730, "width": 900, "height": 35, "text": "3. RASPBERRY PI 4B GPIO HEADER ASSIGNMENTS", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "gpio-box", "type": "rectangle", "x": 30, "y": 780, "width": 1250, "height": 180, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "gpio-txt", "type": "text", "x": 45, "y": 795, "width": 1220, "height": 150, "text": "Pin  | GPIO | Function        | Connected To                    | Library\n─────┼──────┼─────────────────┼────────────────────────────────┼────────────\n  3  |   2  | I²C1 SDA        | All I²C sensors SDA line       | smbus2\n  5  |   3  | I²C1 SCL        | All I²C sensors SCL line       | smbus2\n  8  |  14  | UART0 TX        | ESP32 GPIO18 (UART1 RX)        | pyserial\n 10  |  15  | UART0 RX        | ESP32 GPIO17 (UART1 TX)        | pyserial\n 16  |  23  | Green LED       | LED anode (via 330Ω resistor)  | gpiozero\n 18  |  24  | Red LED         | LED anode (via 330Ω resistor)  | gpiozero\n 22  |  25  | Start Switch    | Momentary button → GND (pull-up)| gpiozero\n─────┴──────┴─────────────────┴────────────────────────────────┴────────────\n\nI²C Bus 1: All 5 sensors share same bus (GPIO2/GPIO3) with unique addresses:\n  0x30 (VL53L0X Left), 0x31 (VL53L0X Right), 0x32 (VL53L1X Front),\n  0x68 (MPU6050 IMU), 0x0D (QMC5883L Magnetometer)\n\nUART:  /dev/serial0 — enable via raspi-config → Interface → Serial Port\n  NO login shell on serial (use for communication only)\n\nCamera: PiCamera on 15-pin CSI connector (FFC ribbon cable)", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s4h", "type": "text", "x": 30, "y": 1000, "width": 900, "height": 35, "text": "4. UART COMMUNICATION PROTOCOL — Complete Packet Format", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "proto-box", "type": "rectangle", "x": 30, "y": 1050, "width": 1250, "height": 330, "strokeColor": "#e03131", "backgroundColor": "#fff5f5", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "proto-txt", "type": "text", "x": 45, "y": 1065, "width": 1220, "height": 300, "text": "UART PACKET FRAME (8 to 32 bytes total):\n\n┌──────┬────────┬────────┬──────┬─────────────┬─────────┬──────┐\n│ 0xA5 │ counter│ type   │ len  │ payload     │ CRC16   │ 0x5A │\n│  1B   │  1B    │  1B    │  1B  │ 0 - 24 bytes │  2B     │  1B  │\n└──────┴────────┴────────┴──────┴─────────────┴─────────┴──────┘\n\nField Details:\n  HEADER (0xA5):    Start-of-frame marker\n  COUNTER:          Rolling 0-255, for duplicate detection & ordering\n  TYPE:             Packet type (see table below)\n  LENGTH:           Number of bytes in payload field\n  PAYLOAD:          Command data (up to 24 bytes)\n  CRC16:            CRC-16-CCITT poly=0x8005, init=0xFFFF, covers header+type+len+payload\n  FOOTER (0x5A):    End-of-frame marker\n\nPACKET TYPES TABLE:\n┌─────────────────────┬──────┬──────────────┬────────────────────────────────┐\n│ Name                │ Code │ Payload Size │ Description                    │\n├─────────────────────┼──────┼──────────────┼────────────────────────────────┤\n│ MOTOR_COMMAND       │ 0x01 │ 1 byte       │ Set motor speed 0-100%         │\n│ SERVO_COMMAND       │ 0x02 │ 4 bytes      │ Set servo angle as float       │\n│ STEERING_COMMAND    │ 0x03 │ 5 bytes      │ Set BOTH: float(4B)+uint8(1B)  │\n│ STATUS_REQ          │ 0x04 │ 0 bytes      │ Pi requests ESP status         │\n│ STATUS_RESP         │ 0x05 │ 6 bytes      │ ESP responds: state, uptime... │\n│ SELFTEST_REQ        │ 0x06 │ 0 bytes      │ Pi requests self-test data     │\n│ SELFTEST_RESP       │ 0x07 │ 8 bytes      │ ESP responds: all test results │\n│ EMERGENCY_STOP      │ 0xFF │ 0 bytes      │ Immediate emergency stop       │\n└─────────────────────┴──────┴──────────────┴────────────────────────────────┘\n\nSTEERING_COMMAND Payload:  [float servo_angle (4 bytes)] [uint8_t motor_speed (1 byte)]\n  servo_angle = -30.0° to +30.0°  |  motor_speed = 0 to 100 (%)\n\nSTATUS_RESPONSE:  [uart_ok][esp_state][uptime_lo][uptime_hi][packets_received][crc_errors]\n\nSELFTEST_RESPONSE:  [uart_ok][servo_ok][motor_ok][tb6612_ok][wdt_ok][duration_lo][duration_hi][all_passed]\n\nCRC-16-CCITT Algorithm (same on Pi + ESP32):\n  poly = 0x8005, init = 0xFFFF\n  for each byte:  crc ^= byte << 8\n  for 8 bits:  if crc & 0x8000 → crc = (crc << 1) ^ 0x8005  else → crc <<= 1\n  crc &= 0xFFFF\n\nUART Config:  115200 baud, 8 data bits, 1 stop bit, no parity, no flow control\nHalf-duplex: Pi sends commands, ESP32 can respond (TX collision avoided by design)", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s5h", "type": "text", "x": 30, "y": 1430, "width": 900, "height": 35, "text": "5. POWER DISTRIBUTION ARCHITECTURE", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "power-box", "type": "rectangle", "x": 30, "y": 1480, "width": 1250, "height": 220, "strokeColor": "#1e1e1e", "backgroundColor": "#fff5f5", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "power-txt", "type": "text", "x": 45, "y": 1495, "width": 1220, "height": 190, "text": "POWER ARCHITECTURE DIAGRAM:\n\n  BATTERY PACK (7.4V - 11.1V, 2S/3S LiPo, 2000mAh+)\n       │\n       ├────► TB6612FNG VM pin  ──► DC Motor (motor sees battery voltage directly)\n       │                          ↑ Motor current: 0.5-2A depending on load\n       │\n       ├────► 5V REGULATOR (UBEC/LM2596, 5A rated)\n       │         │\n       │         ├─► Raspberry Pi 4B (5V GPIO pin 2/4, requires 3A+)\n       │         │     └─► PiCamera module (~250mA via CSI)\n       │         │\n       │         └─► ESP32-S3 (5V pin, onboard 3.3V regulator)\n       │               └─► MG995 Servo (via 5V rail — ⚠️ see note)\n       │\n       └────► 3.3V REGULATOR (AMS1117-3.3 or Pi 3.3V pin)\n                  │\n                  ├─► VL53L0X Left    (@ 0x30, 20mA)\n                  ├─► VL53L0X Right   (@ 0x31, 20mA)\n                  ├─► VL53L1X Front   (@ 0x32, 20mA)\n                  ├─► MPU6050 IMU     (@ 0x68, 3.7mA)\n                  └─► QMC5883L Mag    (@ 0x0D, 10mA)\n\n⚠️  IMPORTANT POWER NOTES:\n  • MG995 Servo draws 500mA-2A under load — DO NOT power from Pi 5V rail!\n    Use separate 5-7.4V supply or battery direct\n  • Pi 4B requires 5V @ 3A minimum — use quality UBEC/BEC\n  • All I²C sensors are 3.3V logic — Pi GPIO is 3.3V tolerant\n  • ESP32-S3 is 3.3V logic but can be powered via 5V pin (onboard reg)\n  • Common ground ALL devices: battery negative to all GNDs\n  • UART between Pi (3.3V) and ESP32 (3.3V) — no level shifter needed\n  • Add 100μF + 0.1μF decoupling caps near servo and motor driver", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "s6h", "type": "text", "x": 30, "y": 1750, "width": 900, "height": 35, "text": "6. COMPLETE DATA FLOW & TIMING BUDGET", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "flow-box", "type": "rectangle", "x": 30, "y": 1800, "width": 1250, "height": 250, "strokeColor": "#1e1e1e", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "flow-txt", "type": "text", "x": 45, "y": 1815, "width": 1220, "height": 220, "text": "DATA FLOW PATH (each control cycle @ 100Hz = 10ms budget):\n\n  ┌──────────┐    ┌────────────┐    ┌──────────┐    ┌──────────┐\n  │ SENSORS  │───►│ FUSION     │───►│ PERCEP-  │───►│ PLANNING │\n  │ 100 Hz   │    │ 100 Hz     │    │ TION     │    │ 20 Hz    │\n  │ Camera   │    │ UKF + Comp │    │ 50 Hz    │    │ Waypoints│\n  │ ToF×3    │    │ Localize   │    │ Lanes    │    │ Splines  │\n  │ IMU+Mag  │    │            │    │ FreeSpace│    │          │\n  └──────────┘    └────────────┘    └──────────┘    └──────────┘\n       │                                               │\n       └───────────────────┬───────────────────────────┘\n                           ▼\n                    ┌────────────┐    ┌──────────┐    ┌──────────┐\n                    │  CONTROL   │───►│ UART TX  │───►│  ESP32   │───► Motor\n                    │  100 Hz    │    │ 200 Hz   │    │          │───► Servo\n                    │ Stanley    │    │ Protocol │    │ FreeRTOS │\n                    │ ServoPID   │    │ Packet   │    │ Tasks    │\n                    │ MotorPID   │    │          │    │          │\n                    └────────────┘    └──────────┘    └──────────┘\n\nTIMING BUDGET (10ms total @ 100Hz):\n  Sensors read (I²C + Camera):  ~2.0ms  (5× I²C reads @ 400kHz + camera capture)\n  Sensor fusion (UKF predict+update):  ~1.0ms  (filterpy UKF: sigma points, predict, update)\n  Perception (Canny + Hough + Sobel):  ~3.0ms  (OpenCV image processing 640×480)\n  Planning (waypoint + spline):        ~2.0ms  (scipy CubicSpline evaluation)\n  Control (Stanley + 2× PID):         ~0.5ms  (simple math operations)\n  UART Tx (serial write 8 bytes):     ~0.1ms  (70μs @ 115200)\n  ─────────────────────────────────────────────────────\n  TOTAL:  ~8.6ms  (14% headroom under 10ms budget)\n\n4WS MECHANISM: Single servo controls all 4 wheels via mechanical linkage\n  Ackermann geometry: inner wheel turns sharper than outer wheel\n  Wheelbase: 0.26m  |  Track width: 0.18m  |  Max steering: ±30°\n  Servo gear ratio: 1:1 (direct mechanical coupling)", "fontSize": 13, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 }
  ],
  "files": {}
}