    { "id": "t-runall", "type": "text", "x": 680, "y": 90, "width": 320, "height": 110, "text": "run_all.py :: main()  [line 49]\n• argparse: --mode --config --port --log-level\n• Set env: WRO_CONFIG, WRO_UART_PORT\n• check_dependencies():\n  - numpy, opencv-python, pyserial\n  - else \"pip install -r requirements.txt\"\n• chdir to project root", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

