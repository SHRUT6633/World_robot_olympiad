    { "id": "tm-boot", "type": "text", "x": 45, "y": 310, "width": 310, "height": 70, "text": "▶ boot [DEFAULT]  (line 93)\ncheck_deps → Logger.init() →\npi.boot :: boot_sequence()\n(LED → self-test → switch → race)", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

