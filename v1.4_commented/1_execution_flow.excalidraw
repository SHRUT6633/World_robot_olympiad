    { "id": "tm-sim", "type": "text", "x": 415, "y": 435, "width": 310, "height": 50, "text": "▶ sim  (line 106)\nasyncio.run(pi_main())\nSimulation mode", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

