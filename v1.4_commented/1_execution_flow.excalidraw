    { "id": "tm-race", "type": "text", "x": 785, "y": 310, "width": 310, "height": 70, "text": "▶ race / pi / full  (line 114)\n→ pi.main :: main() directly\n→ asyncio.run()\nfull: Pi+ESP32 UART enabled", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

    { "id": "bm-esp", "type": "rectangle", "x": 30, "y": 420, "width": 340, "height": 80, "strokeColor": "#1971c2", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "roundness": { "type": 3, "value": 8 } },
    { "id": "tm-esp", "type": "text", "x": 45, "y": 435, "width": 310, "height": 50, "text": "▶ esp  (line 72)\nidf.py -C esp flash\n(Flash ESP32 firmware)", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

