    { "id": "tm-test", "type": "text", "x": 785, "y": 435, "width": 310, "height": 50, "text": "▶ test  (line 67)\npytest tests/ -v\n(4 test suites, ~20 tests)", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

