    { "id": "tm-self", "type": "text", "x": 415, "y": 310, "width": 310, "height": 70, "text": "▶ selftest  (line 78)\n→ power_on_self_test()\n→ Print results → exit 0/1\n(no LED, no switch, no race)", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "roughness": 0, "opacity": 100 },

